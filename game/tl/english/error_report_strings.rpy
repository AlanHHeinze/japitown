# Traducciones del panel de reporte de errores (jp_error_screen)
# "Salir" ya se traduce en tl/english/script/ui/base/screens.rpy -> "Quit"

translate english strings:

    old "Ocurrió un error"
    new "An error occurred"

    old "El juego encontró un problema. Podés reportarlo para que se corrija."
    new "The game ran into a problem. You can report it so it gets fixed."

    old "✅ Reporte enviado. ¡Gracias!"
    new "✅ Report sent. Thanks!"

    old "❌ No se pudo enviar. Tocá 📋 Copiar y pegá el reporte en el Discord."
    new "❌ Couldn't send it. Tap 📋 Copy and paste the report in Discord."

    old "⚠️ El reporte no está configurado todavía (falta el webhook)."
