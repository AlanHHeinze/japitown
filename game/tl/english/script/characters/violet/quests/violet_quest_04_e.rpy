translate english quest_violet_questprincipal_04_e_983b91a6:

    # mc "No lo pensé, pero si te hace sentir más comoda, puedo usar algún cosplay también"
    mc "I hadn't thought about it, but if it makes you feel more comfortable, I can wear a cosplay too"

# game/script/characters/violet/quests/violet_quest_04_e.rpy:75
translate english quest_violet_questprincipal_04_e_40478457:

    # violet "Está bien, pero que no sea algo tan llamativo y apretado esta vez"
