translate english quest_violet_questprincipal_04_e_4cf97414:

    # mc "No voy a insistirte más con el cosplay, pero si en que vayamos a la Japicon"
    mc "I won't push you about the cosplay anymore, but I will about us going to the Japicon"

# game/script/characters/violet/quests/violet_quest_04_e.rpy:53
translate english quest_violet_questprincipal_04_e_c35e1587:

    # violet "No se... sigue dandome verguenza la idea"
    violet "I don't know... the idea still embarrasses me"

# game/script/characters/violet/quests/violet_quest_04_e.rpy:57
translate english quest_violet_questprincipal_04_e_238d60c8:

    # mc "Piensa que va a ir mucha gente y mucha va a usar cosplay, no te tiene que dar verguenza"
