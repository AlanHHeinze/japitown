# game/script/characters/violet/quests/violet_quest_04_e.rpy:44
translate english quest_violet_questprincipal_04_e_6e49067d:

    # mc "No, esta es buena, podría encargar en la tienda un cosplay nuevo y que lo envien, si no quieres usar el que tienes, podemos comprar otro"
    mc "No, this one's good. I could order a new cosplay from the store and have it shipped; if you don't want to wear the one you have, we can buy another"

